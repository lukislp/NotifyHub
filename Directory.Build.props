<Project>
  <!--
    NuGet lock files (packages.lock.json next to every project): restore resolves exactly the
    recorded package graph, and in CI (GitHub Actions sets CI=true) the restore fails instead
    of silently updating the lock when a csproj and its lock file disagree (OpenSSF Scorecard
    Pinned-Dependencies). Dependabot updates the lock files together with the csproj versions;
    locally a plain `dotnet restore` refreshes them after a package change.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
