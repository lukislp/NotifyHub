{
    "branches":  [
                     "main"
                 ],
    "plugins":  [
                    "@semantic-release/commit-analyzer",
                    "@semantic-release/release-notes-generator",
                    {
                        "value":  [
                                      "@semantic-release/github",
                                      {
                                          "assets":  [
                                                         {
                                                             "path":  "packages/*.nupkg",
                                                             "label":  "NuGet package"
                                                         },
                                                         {
                                                             "path":  "packages/*.snupkg",
                                                             "label":  "Symbol package"
                                                         }
                                                     ]
                                      }
                                  ],
                        "Count":  2
                    }
                ]
}
