{
  "branches": [
    "main"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "packages/*.nupkg",
            "label": "NuGet package"
          },
          {
            "path": "packages/*.snupkg",
            "label": "Symbol package"
          }
        ]
      }
    ]
  ]
}
